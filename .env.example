# -----------------------------------------------------------------------------
# Freelink frontend environment
# Copy to .env and fill in only after the backend / contract team confirms values.
# NEVER put secrets, private keys or passwords in VITE_* variables — they are
# bundled into the browser.
# -----------------------------------------------------------------------------

# Backend REST API. Leave empty to keep the app fully working on mock services.
VITE_API_BASE_URL=

# "true" (default) uses src/services/mocks. Set to "false" only after endpoints exist.
VITE_USE_MOCK_API=true

# Google OAuth client id (public). Leave empty to keep the clearly-labelled mock login.
VITE_GOOGLE_CLIENT_ID=

# ---- Blockchain: FreelinkEscrow v2 (native ETH) -------------------------------
# The values below are the Sepolia TEST deployment from smart-contact/ (public
# data, no value). Replace them after a new `npm run deploy:sepolia`; note that
# every deploy produces a new address and the contract's policy values are fixed.
# The ABI lives in src/config/FreelinkEscrow.abi.json (copy of smart-contact/abi/).
VITE_CHAIN_ID=11155111
VITE_CONTRACT_ADDRESS=0xa932Ba2dAA2531c6aEE6c04738Bdde3dFE8f6904
VITE_EXPLORER_URL=https://sepolia.etherscan.io
# Fixed THB per 1 ETH used to turn a baht budget into the ETH that is deposited.
# Interim product decision (not a market price). Leave empty to disable deposits.
# Example: 100000 means 50,000 THB is deposited as 0.5 ETH.
VITE_THB_PER_ETH=
